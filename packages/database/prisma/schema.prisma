generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETION_PENDING
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  DELETION_PENDING
}

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  AGENT
  VIEWER
}

enum MemberStatus {
  INVITED
  ACTIVE
  REMOVED
}

// Single-use token table backing magic-link login, org invites, password reset,
// and email verification. See docs/adr/0004 for why this is one table, not four.
enum AuthTokenPurpose {
  LOGIN
  ORGANIZATION_INVITE
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String?
  name            String
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions              Session[]
  magicLinkTokens       MagicLinkToken[]
  organizationMembers   OrganizationMember[] @relation("MemberUser")
  sentInvites           OrganizationMember[] @relation("InvitedBy")
  auditLogEntries       AuditLog[]
  assignedConversations Conversation[]
  assignedLeads         Lead[]
  assignedTasks         Task[]
  loggedActivities      Activity[]
  createdFollowUps      FollowUp[]
  createdContentItems   ContentItem[]        @relation("ContentCreatedBy")
  approvedContentItems  ContentItem[]        @relation("ContentApprovedBy")
  rejectedContentItems  ContentItem[]        @relation("ContentRejectedBy")
  assignedViewings      Viewing[]

  @@map("users")
}

model Session {
  id        String    @id @default(uuid())
  // SHA-256 of the opaque token stored in the session cookie. The raw token is
  // never persisted, so a DB read/log leak alone can't be replayed as a live session.
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?

  @@index([userId])
  @@map("sessions")
}

model MagicLinkToken {
  id                   String              @id @default(uuid())
  userId               String
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash            String              @unique
  purpose              AuthTokenPurpose
  // For ORGANIZATION_INVITE tokens, the pending membership this token will activate.
  organizationMemberId String?             @unique
  organizationMember   OrganizationMember? @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)
  expiresAt            DateTime
  consumedAt           DateTime?
  createdAt            DateTime            @default(now())

  @@index([userId, purpose])
  @@map("magic_link_tokens")
}

model Organization {
  id               String             @id @default(uuid())
  name             String
  slug             String             @unique
  status           OrganizationStatus @default(ACTIVE)
  // Selects which packages/verticals config (nav, terminology, enabled modules,
  // and eventually domain modules/AI tools) this org runs on. A plain string,
  // not a Prisma enum, deliberately - the vertical registry is TS-code-driven
  // (see packages/verticals), so adding a new vertical never requires a migration.
  // Unknown/missing values fall back to "core" in getVerticalConfig - see that
  // fallback before assuming every org has a value matching a registered vertical.
  vertical         String             @default("core")
  // Set on first checkout - null means this org has never started a Stripe
  // Checkout/Portal session yet, not that billing failed.
  stripeCustomerId String?            @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  subscription             Subscription?
  members                  OrganizationMember[]
  auditLogs                AuditLog[]
  connectedAccounts        ConnectedAccount[]
  webhookEvents            ProviderWebhookEvent[]
  contacts                 Contact[]
  conversations            Conversation[]
  messages                 Message[]
  businessProfile          BusinessProfile?
  products                 Product[]
  services                 Service[]
  knowledgeChunks          KnowledgeChunk[]
  aiResponses              AiResponse[]
  pipelines                Pipeline[]
  leads                    Lead[]
  activities               Activity[]
  tasks                    Task[]
  tags                     Tag[]
  followUps                FollowUp[]
  automations              Automation[]
  automationExecutions     AutomationExecution[]
  contentItems             ContentItem[]
  contentMediaAssets       ContentMediaAsset[]
  properties               Property[]
  viewings                 Viewing[]
  buyerPreferences         BuyerPreference[]
  socialMediaItems         SocialMediaItem[]
  socialMediaAssets        SocialMediaAsset[]
  propertyImportCandidates PropertyImportCandidate[]
  propertyMedia            PropertyMedia[]
  socialSyncs              SocialSync[]

  @@map("organizations")
}

model OrganizationMember {
  id              String           @id @default(uuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String
  user            User             @relation("MemberUser", fields: [userId], references: [id], onDelete: Cascade)
  role            OrganizationRole
  status          MemberStatus     @default(INVITED)
  invitedByUserId String?
  invitedBy       User?            @relation("InvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  invitedAt       DateTime         @default(now())
  joinedAt        DateTime?

  inviteToken MagicLinkToken?

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@map("organization_members")
}

// Small, stable reference data (3 rows: solo/team/agency) - seeded directly
// in this model's own migration rather than via a seed script, since none
// exists in this repo yet. Not exposed for self-serve editing; changing
// prices means a new migration, same as any other reference-data change.
model Plan {
  id         String   @id @default(uuid())
  key        String   @unique
  name       String
  priceCents Int
  currency   String   @default("USD")
  interval   String   @default("month")
  createdAt  DateTime @default(now())

  subscriptions Subscription[]

  @@map("plans")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model Subscription {
  id                   String             @id @default(uuid())
  organizationId       String             @unique
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId               String
  plan                 Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(TRIALING)
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("subscriptions")
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String?
  actor          User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String
  metadata       Json          @default("{}")
  requestId      String
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Phase 2: Instagram messaging. See docs/architecture/provider-abstraction.md
// and docs/architecture/tenant-model.md for the design this implements.
// ---------------------------------------------------------------------------

enum Provider {
  INSTAGRAM
  TIKTOK
}

enum ConnectedAccountStatus {
  CONNECTED
  ACTION_REQUIRED
  TOKEN_EXPIRED
  DISCONNECTED
  ERROR
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSenderType {
  CUSTOMER
  HUMAN
  SYSTEM
  AI
  AUTOMATION
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  STICKER
  SYSTEM
  UNKNOWN
}

enum MessageStatus {
  PENDING
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

// Not yet driven by anything in Phase 2 (no AI/automation exists yet) - modeled
// now so Phase 3 doesn't need a migration to wire AI into conversation state.
enum ConversationAutomationState {
  AI_ACTIVE
  HUMAN_ACTIVE
  PAUSED
  CLOSED
}

enum OutboxEventStatus {
  PENDING
  DISPATCHED
  FAILED
}

model ConnectedAccount {
  id                   String                 @id @default(uuid())
  organizationId       String
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider             Provider
  externalAccountId    String
  displayName          String?
  username             String?
  accountType          String?
  avatarUrl            String?
  status               ConnectedAccountStatus @default(CONNECTED)
  encryptedAccessToken String
  tokenExpiresAt       DateTime?
  grantedScopes        String[]               @default([])
  capabilities         Json                   @default("{}")
  providerMetadata     Json                   @default("{}")
  lastSyncAt           DateTime?
  lastWebhookAt        DateTime?
  lastErrorCode        String?
  lastErrorAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  webhookEvents     ProviderWebhookEvent[]
  contactIdentities ContactIdentity[]
  conversations     Conversation[]
  messages          Message[]
  contentItems      ContentItem[]
  socialMediaItems  SocialMediaItem[]
  socialSyncs       SocialSync[]

  // Global, not per-org: this is the trust boundary inbound webhooks resolve
  // organizationId through. One external account can only ever belong to one org.
  @@unique([provider, externalAccountId])
  @@index([organizationId])
  @@map("connected_accounts")
}

model ProviderWebhookEvent {
  id                 String             @id @default(uuid())
  provider           Provider
  externalEventId    String
  connectedAccountId String?
  connectedAccount   ConnectedAccount?  @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)
  organizationId     String?
  organization       Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  payload            Json
  status             WebhookEventStatus @default(RECEIVED)
  attemptCount       Int                @default(0)
  lastError          String?
  receivedAt         DateTime           @default(now())
  processedAt        DateTime?

  // Prevents "same webhook delivered N times" from ever being processed twice.
  @@unique([provider, externalEventId])
  @@index([status, receivedAt])
  @@map("provider_webhook_events")
}

model Contact {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  displayName    String
  // Nullable - only populated for contacts that arrive with a direct contact
  // method (e.g. a public storefront booking), not for provider-identity-only
  // contacts (Instagram/TikTok), which are reached via ContactIdentity instead.
  phone          String?
  email          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  identities       ContactIdentity[]
  conversations    Conversation[]
  leads            Lead[]
  buyerPreferences BuyerPreference[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, phone])
  @@map("contacts")
}

model ContactIdentity {
  id                 String           @id @default(uuid())
  contactId          String
  contact            Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  provider           Provider
  connectedAccountId String
  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  externalId         String
  displayName        String?
  profilePictureUrl  String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([provider, connectedAccountId, externalId])
  @@map("contact_identities")
}

model Conversation {
  id                 String                      @id @default(uuid())
  organizationId     String
  organization       Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedAccountId String
  connectedAccount   ConnectedAccount            @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  contactId          String
  contact            Contact                     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  provider           Provider
  assignedUserId     String?
  assignedUser       User?                       @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  automationState    ConversationAutomationState @default(HUMAN_ACTIVE)
  lastMessageAt      DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  messages     Message[]
  aiResponses  AiResponse[]
  sourcedLeads Lead[]

  @@unique([connectedAccountId, contactId])
  @@index([organizationId, updatedAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id                 String            @id @default(uuid())
  organizationId     String
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversationId     String
  conversation       Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  connectedAccountId String
  connectedAccount   ConnectedAccount  @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  provider           Provider
  providerMessageId  String?
  direction          MessageDirection
  senderType         MessageSenderType
  senderUserId       String?
  messageType        MessageType       @default(TEXT)
  text               String?
  status             MessageStatus     @default(PENDING)
  replyToMessageId   String?
  providerTimestamp  DateTime?
  metadata           Json              @default("{}")
  createdAt          DateTime          @default(now())

  aiResponseAsTrigger AiResponse? @relation("AiResponseTrigger")
  aiResponseAsResult  AiResponse? @relation("AiResponseResult")

  // Multiple pending outbound messages can share providerMessageId = NULL;
  // Postgres treats NULLs as distinct in unique constraints, so this is safe.
  @@unique([provider, providerMessageId])
  @@index([organizationId, conversationId, createdAt(sort: Desc)])
  @@map("messages")
}

model OutboxEvent {
  id             String            @id @default(uuid())
  organizationId String?
  aggregateType  String
  aggregateId    String
  eventType      String
  payload        Json
  status         OutboxEventStatus @default(PENDING)
  attemptCount   Int               @default(0)
  lastError      String?
  createdAt      DateTime          @default(now())
  dispatchedAt   DateTime?

  @@index([status, createdAt])
  @@map("outbox_events")
}

// ---------------------------------------------------------------------------
// Phase 3: AI sales. See docs/architecture/ (AI provider abstraction, RAG) and
// docs/adr/ for the design this implements.
// ---------------------------------------------------------------------------

enum KnowledgeSourceType {
  MANUAL
  PRODUCT
  SERVICE
  FAQ
}

enum KnowledgeEmbeddingStatus {
  PENDING
  READY
  FAILED
}

enum AiResponseStatus {
  PENDING
  COMPLETED
  FAILED
  SKIPPED
}

model BusinessProfile {
  id                  String       @id @default(uuid())
  organizationId      String       @unique
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessName        String
  description         String?
  // Free-text instructions steering the AI agent's tone/persona.
  tone                String?
  timezone            String       @default("UTC")
  businessHours       Json?
  // New conversations only start automationState = AI_ACTIVE when this is true;
  // otherwise they default to HUMAN_ACTIVE (see Conversation.automationState).
  aiEnabled           Boolean      @default(false)
  // Nullable override of AI_DEFAULT_MODEL env var - keeps the model swappable
  // per org without a code change.
  defaultModel        String?
  // Null = no cap. Enforced in apps/worker-ai against summed AiResponse.costCents.
  monthlyCostCapCents Int?
  // Phase 6: when true, ContentItem.submit() skips PENDING_APPROVAL and goes
  // straight to APPROVED (audited via an AuditLog "content.auto_approved"/
  // "content.auto_published" row) - opt-in, default off.
  autoPublishEnabled  Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@map("business_profiles")
}

model Product {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  priceCents     Int?
  currency       String       @default("USD")
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@map("products")
}

model Service {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  priceCents      Int?
  currency        String       @default("USD")
  durationMinutes Int?
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId])
  @@map("services")
}

model KnowledgeChunk {
  id              String                       @id @default(uuid())
  organizationId  String
  organization    Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceType      KnowledgeSourceType          @default(MANUAL)
  sourceId        String?
  content         String                       @db.Text
  // Prisma has no native vector type; DDL for this column is hand-written in
  // the migration SQL (see 0000..._phase3_ai_sales) and read/written via raw
  // SQL ($queryRaw/$executeRaw), never through the normal query builder.
  embedding       Unsupported("vector(1024)")?
  embeddingStatus KnowledgeEmbeddingStatus     @default(PENDING)
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  @@index([organizationId])
  @@map("knowledge_chunks")
}

// One row per AI turn. triggerMessageId's uniqueness is the atomic claim that
// makes double-processing the same inbound message impossible (create() fails
// with P2002 on a duplicate attempt) - mirrors the ContactIdentity/ConnectedAccount
// unique-constraint-as-claim pattern from Phase 2. Also doubles as the usage/cost ledger.
model AiResponse {
  id                  String           @id @default(uuid())
  organizationId      String
  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversationId      String
  conversation        Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  triggerMessageId    String           @unique
  triggerMessage      Message          @relation("AiResponseTrigger", fields: [triggerMessageId], references: [id], onDelete: Cascade)
  resultMessageId     String?          @unique
  resultMessage       Message?         @relation("AiResponseResult", fields: [resultMessageId], references: [id], onDelete: SetNull)
  status              AiResponseStatus @default(PENDING)
  model               String?
  inputTokens         Int?
  outputTokens        Int?
  cacheReadTokens     Int?
  cacheCreationTokens Int?
  costCents           Int?
  toolCallCount       Int              @default(0)
  errorMessage        String?
  createdAt           DateTime         @default(now())
  completedAt         DateTime?

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("ai_responses")
}

// ---------------------------------------------------------------------------
// Phase 4: CRM. See docs/architecture/bounded-contexts.md and
// docs/architecture/erd.md's forward-look for the design this implements.
// ---------------------------------------------------------------------------

enum ActivityType {
  NOTE
  STAGE_CHANGE
  MESSAGE_LOGGED
  TASK_COMPLETED
  SYSTEM
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

// One pipeline per org for the MVP (auto-created lazily via
// getOrCreateDefaultPipeline in @yoyo/database), but not hard-locked to one -
// no @@unique([organizationId]) - so a second pipeline is a schema-compatible
// later addition, not a migration.
model Pipeline {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  stages PipelineStage[]
  leads  Lead[]

  // Not a "one pipeline per org" lock - just makes the lazy
  // find-or-create race safe (concurrent creators hit P2002 and re-fetch
  // instead of duplicating), per docs/adr's unique-constraint-as-claim pattern.
  @@unique([organizationId, name])
  @@map("pipelines")
}

model PipelineStage {
  id         String   @id @default(uuid())
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name       String
  order      Int
  isWon      Boolean  @default(false)
  isLost     Boolean  @default(false)
  createdAt  DateTime @default(now())

  leads Lead[]

  @@unique([pipelineId, order])
  @@map("pipeline_stages")
}

model Lead {
  id                   String        @id @default(uuid())
  organizationId       String
  organization         Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId            String
  contact              Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  pipelineId           String
  pipeline             Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stageId              String
  stage                PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  title                String
  // Real-estate-specific classification (buyer/renter vs. seller/landlord);
  // always null for core-vertical orgs. TransactionType on BuyerPreference
  // covers what a buyer/renter is searching for - this is a different axis,
  // which side of the deal the lead is on.
  intent               LeadIntent?
  valueCents           Int?
  currency             String        @default("USD")
  sourceConversationId String?
  sourceConversation   Conversation? @relation(fields: [sourceConversationId], references: [id], onDelete: SetNull)
  assignedUserId       String?
  assignedUser         User?         @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  closedAt             DateTime?

  activities           Activity[]
  tasks                Task[]
  tags                 LeadTag[]
  followUps            FollowUp[]
  automationExecutions AutomationExecution[]
  properties           LeadProperty[]
  viewings             Viewing[]

  @@index([organizationId, updatedAt(sort: Desc)])
  @@index([contactId])
  @@map("leads")
}

// Append-only timeline per lead - distinct from AuditLog (security/compliance
// audit trail): this is a sales-relevant history view (notes, stage changes,
// logged messages, completed tasks), some human-authored, some system/AI-authored
// (actorUserId null).
model Activity {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type           ActivityType
  content        String
  actorUserId    String?
  actorUser      User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([leadId, createdAt(sort: Desc)])
  @@map("activities")
}

// No reminder/notification/scheduling logic here - that's Phase 5's follow-up
// scheduler. A Task here is just an assignable to-do tied to a lead.
model Task {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  dueAt          DateTime?
  status         TaskStatus   @default(OPEN)
  assignedUserId String?
  assignedUser   User?        @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  completedAt    DateTime?

  @@index([organizationId, dueAt])
  @@index([leadId])
  @@map("tasks")
}

model Tag {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  color          String?
  createdAt      DateTime     @default(now())

  leads LeadTag[]

  @@unique([organizationId, name])
  @@map("tags")
}

model LeadTag {
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([leadId, tagId])
  @@map("lead_tags")
}

// ---------------------------------------------------------------------------
// Phase 5: Follow-ups & Automations. See docs/architecture/bounded-contexts.md
// and docs/architecture/queue-topology.md for the design this implements.
//
// Two structurally different mechanisms:
// - FollowUp is TIME-driven ("fire at time X") - scheduledFor is the durable
//   source of truth, polled by FollowUpDispatcherService (apps/api/src/common).
// - Automation is EVENT-driven ("when X happens, do Y") - reuses the existing
//   transactional outbox (OutboxEvent) unchanged; see lead.created/
//   lead.stage_changed in apps/api/src/common/outbox.service.ts.
//
// No-infinite-loop invariant (by construction, not runtime cycle-detection):
// none of AutomationActionType's actions (CREATE_FOLLOW_UP, CREATE_TASK,
// ADD_TAG) produce a lead.created or lead.stage_changed event, so no
// Automation in this phase's initial trigger/action set can ever re-trigger
// itself or another Automation. Adding a new trigger/action pair later must
// re-check this invariant explicitly.
// ---------------------------------------------------------------------------

enum FollowUpActionType {
  SEND_MESSAGE
  CREATE_TASK
}

enum FollowUpStatus {
  PENDING
  // Atomic claim state (PENDING -> SENDING via updateMany) so two concurrent
  // workers processing the same due follow-up can't both execute its action -
  // mirrors Message's PENDING -> SENDING claim in worker-messaging's send.ts.
  SENDING
  SENT
  CANCELLED
  FAILED
}

model FollowUp {
  id              String             @id @default(uuid())
  organizationId  String
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId          String
  lead            Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actionType      FollowUpActionType
  // {text} for SEND_MESSAGE, {title, description?} for CREATE_TASK - validated
  // by packages/contracts's discriminated union, not enforced at the DB layer.
  actionConfig    Json
  // Already business-hours-adjusted at creation time (see
  // resolveNextSendTime in @yoyo/database) - never re-adjusted at dispatch.
  scheduledFor    DateTime
  status          FollowUpStatus     @default(PENDING)
  // Null = created by an Automation or the AI's SCHEDULE_FOLLOW_UP action.
  createdByUserId String?
  createdByUser   User?              @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  cancelledAt     DateTime?
  executedAt      DateTime?
  errorMessage    String?
  createdAt       DateTime           @default(now())

  @@index([status, scheduledFor])
  @@index([leadId])
  @@map("follow_ups")
}

enum AutomationTriggerType {
  LEAD_CREATED
  LEAD_STAGE_CHANGED
  // Fires when a property is created/updated to ACTIVE and matches a
  // contact's saved BuyerPreference - see properties.service.ts's
  // "property.activated" outbox emission and the dispatcher's matching query.
  LISTING_MATCHED
}

enum AutomationActionType {
  CREATE_FOLLOW_UP
  CREATE_TASK
  ADD_TAG
}

model Automation {
  id             String                @id @default(uuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  triggerType    AutomationTriggerType
  // e.g. {toStageId} to scope LEAD_STAGE_CHANGED to one destination stage.
  triggerConfig  Json?
  actionType     AutomationActionType
  // Shape depends on actionType - validated by packages/contracts.
  actionConfig   Json
  enabled        Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  executions AutomationExecution[]

  @@index([organizationId, triggerType, enabled])
  @@map("automations")
}

enum AutomationExecutionStatus {
  // Set at claim time (the row's mere existence is the idempotency claim -
  // see the model comment below), then updated to COMPLETED/FAILED - mirrors
  // AiResponse's PENDING -> COMPLETED/FAILED lifecycle exactly.
  PENDING
  COMPLETED
  FAILED
  SKIPPED
}

// One row per (automation, triggering event) - triggerEventId is the causing
// OutboxEvent's id. @@unique below is the idempotency claim: a duplicate
// firing attempt (e.g. a retried BullMQ job) hits P2002 and is skipped,
// mirroring AiResponse.triggerMessageId's unique-constraint-as-claim pattern.
model AutomationExecution {
  id             String                    @id @default(uuid())
  automationId   String
  automation     Automation                @relation(fields: [automationId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String?
  lead           Lead?                     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  triggerEventId String
  status         AutomationExecutionStatus
  errorMessage   String?
  createdAt      DateTime                  @default(now())

  @@unique([automationId, triggerEventId])
  @@map("automation_executions")
}

// ---------------------------------------------------------------------------
// Phase 6: Content & Publishing. See docs/architecture/provider-abstraction.md
// and docs/adr/0007-content-publishing-provider-and-media-design.md for the
// design this implements.
//
// ContentItem.status state machine:
//   DRAFT --generate-caption--> GENERATING --success--> DRAFT
//                                          \--failure--> GENERATION_FAILED
//   DRAFT / GENERATION_FAILED --submit--> PENDING_APPROVAL
//     (or straight to APPROVED if BusinessProfile.autoPublishEnabled - see
//     autoApproved below)
//   PENDING_APPROVAL --approve--> APPROVED
//   PENDING_APPROVAL --reject--> REJECTED (terminal)
//   APPROVED --dispatcher claims (scheduledFor<=now)--> PUBLISHING
//   PUBLISHING --success--> PUBLISHED (terminal)
//   PUBLISHING --RETRYABLE provider failure--> APPROVED (BullMQ retries)
//   PUBLISHING --NON_RETRYABLE/ACTION_REQUIRED/REQUIRES_RECONCILIATION--> PUBLISH_FAILED (terminal)
//   DRAFT / PENDING_APPROVAL / APPROVED --cancel--> CANCELLED (terminal)
//
// No separate "SCHEDULED" status: scheduledFor is nullable-then-defaulted at
// approval time (null = ASAP), exactly mirroring FollowUp.scheduledFor from
// Phase 5 - the dispatcher polls status='APPROVED' AND scheduledFor <= now().
// ---------------------------------------------------------------------------

enum ContentPostType {
  IMAGE
  VIDEO
  CAROUSEL
}

enum ContentItemStatus {
  DRAFT
  GENERATING
  GENERATION_FAILED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  // Atomic claim state (APPROVED -> PUBLISHING via updateMany), mirrors
  // Message's PENDING -> SENDING claim - this is the duplicate-publish
  // prevention exit criterion. Reverted to APPROVED on a RETRYABLE provider
  // failure so the next dispatch attempt can re-claim it.
  PUBLISHING
  PUBLISHED
  PUBLISH_FAILED
  CANCELLED
}

enum MediaAssetKind {
  IMAGE
  VIDEO
}

enum MediaAssetStatus {
  UPLOADED
  ENHANCING
  ENHANCED
  ENHANCEMENT_FAILED
}

model ContentItem {
  id                     String            @id @default(uuid())
  organizationId         String
  organization           Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedAccountId     String
  connectedAccount       ConnectedAccount  @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  // Denormalized off connectedAccount - avoids a join for dispatch routing,
  // same reasoning as Message.provider / ContactIdentity.provider.
  provider               Provider
  postType               ContentPostType
  caption                String?           @db.Text
  // The instruction that seeded the last AI caption generation, if any - kept
  // for "regenerate" and for audit ("what did we ask the model").
  captionPrompt          String?
  generationError        String?
  status                 ContentItemStatus @default(DRAFT)
  // Null = publish ASAP once approved (defaulted to now() at approval time,
  // never left null past APPROVED) - mirrors FollowUp.scheduledFor.
  scheduledFor           DateTime?
  // True when approval was skipped because BusinessProfile.autoPublishEnabled
  // was on at submit time - drives the "content.auto_approved"/
  // "content.auto_published" AuditLog rows.
  autoApproved           Boolean           @default(false)
  submittedForApprovalAt DateTime?
  approvedAt             DateTime?
  approvedByUserId       String?
  approvedByUser         User?             @relation("ContentApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  rejectedAt             DateTime?
  rejectedByUserId       String?
  rejectedByUser         User?             @relation("ContentRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: SetNull)
  rejectionReason        String?
  createdByUserId        String?
  createdByUser          User?             @relation("ContentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  // Best-effort debugging/audit trail of provider-side container/publish ids -
  // NOT used for crash-resumption. A retried publish re-runs the whole
  // provider call rather than resuming a partial container; both Instagram
  // and TikTok auto-expire orphaned unpublished containers on their own.
  providerContainerId    String?
  providerPostId         String?
  publishAttemptCount    Int               @default(0)
  publishErrorMessage    String?
  // e.g. { requiresReconciliation: true } - mirrors Message.metadata.
  metadata               Json              @default("{}")
  publishedAt            DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  media ContentMediaAsset[]

  @@index([organizationId, status, scheduledFor])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("content_items")
}

// Carousel ordering is modeled purely through @@unique([contentItemId, order])
// - no join table, since an asset belongs to exactly one ContentItem (not
// reused across items, unlike LeadTag's genuine many-to-many). Single
// image/video items are just carousels of size 1 in the data model.
model ContentMediaAsset {
  id                 String           @id @default(uuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contentItemId      String
  contentItem        ContentItem      @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  // 0-based; IMAGE/VIDEO items always have exactly one asset at order 0,
  // CAROUSEL items have 2-10 ordered assets (validated by ContentService, not
  // the DB - Instagram's own carousel child cap).
  order              Int
  kind               MediaAssetKind
  // S3 key of the asset actually used for publishing - if enhanced, this is
  // the enhanced output, not the original upload.
  storageKey         String
  // Set only when this asset went through Gemini enhancement - preserves the
  // pre-enhancement upload for audit / "revert to original."
  originalStorageKey String?
  mimeType           String
  byteSize           Int?
  status             MediaAssetStatus @default(UPLOADED)
  enhancementPrompt  String?
  enhancementError   String?
  createdAt          DateTime         @default(now())

  @@unique([contentItemId, order])
  @@index([organizationId])
  @@map("content_media_assets")
}

// ---------------------------------------------------------------------------
// Vertical Phase 2: Real Estate domain foundation. See packages/verticals for
// the config registry this data model backs. Lead/Pipeline/Contact are
// deliberately untouched - a Lead can link to zero or more Property rows via
// LeadProperty (mirrors LeadTag) instead of gaining property-specific columns
// itself, keeping the Core CRM vertical-agnostic. Additive only.
// ---------------------------------------------------------------------------

enum PropertyType {
  APARTMENT
  HOUSE
  COMMERCIAL
  LAND
}

enum PropertyStatus {
  DRAFT
  ACTIVE
  UNDER_OFFER
  SOLD
  RENTED
  ARCHIVED
}

enum TransactionType {
  SALE
  RENT
}

enum LeadIntent {
  BUYER
  RENTER
  SELLER
  LANDLORD
}

enum RentBillingPeriod {
  DAY
  WEEK
  MONTH
}

enum FinancingType {
  CASH
  MORTGAGE
}

enum PurchaseTimeframe {
  IMMEDIATE
  WITHIN_3_MONTHS
  WITHIN_6_MONTHS
  FLEXIBLE
}

// Marketplace/storefront participation must be explicit (default PRIVATE) -
// no code reads this yet, it exists now so a later storefront/marketplace
// phase is additive rather than a data migration.
enum PropertyVisibility {
  PRIVATE
  ORGANIZATION_STOREFRONT
  MARKETPLACE
}

model Property {
  id                  String             @id @default(uuid())
  organizationId      String
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title               String
  description         String?            @db.Text
  propertyType        PropertyType
  status              PropertyStatus     @default(DRAFT)
  visibility          PropertyVisibility @default(PRIVATE)
  transactionType     TransactionType    @default(SALE)
  // priceCents is the sale price when transactionType is SALE, or the rent
  // amount per rentBillingPeriod when RENT - interpretation is conditional
  // on transactionType, not a unit stored separately per row. BigInt, not
  // Int - a real AMD-denominated property (~55,000,000 AMD) already exceeds
  // INT4's ~2.1B cap once multiplied by 100 for cents; a real live crash,
  // not a hypothetical.
  priceCents          BigInt?
  currency            String             @default("USD")
  rentBillingPeriod   RentBillingPeriod?
  depositCents        BigInt?
  minRentalPeriodDays Int?
  availableFrom       DateTime?
  country             String?
  district            String?
  city                String?
  address             String?
  bedrooms            Int?
  bathrooms           Int?
  areaSqm             Float?
  floor               Int?
  totalFloors         Int?
  condition           String?
  buildingType        String?
  // Optional geo enrichment - never required for manual creation, populated
  // only when available (e.g. from a social import). No geocoder exists yet.
  countryCode         String?
  region              String?
  formattedAddress    String?
  latitude            Float?
  longitude           Float?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  leads               LeadProperty[]
  viewings            Viewing[]
  media               PropertyMedia[]
  socialMediaItems    SocialMediaItem[]
  possibleExistingFor PropertyImportCandidate[] @relation("PossibleExistingProperty")
  importedFrom        PropertyImportCandidate[] @relation("ImportedProperty")

  @@index([organizationId, status])
  // Not queried by anything today - kept from an in-progress cross-org
  // marketplace search that was scoped out (YoYo is B2B2C, not a public
  // marketplace), but the index is additive/inert and matches the general
  // "don't build the network now, don't block it later" stance.
  @@index([visibility, status, createdAt])
  @@map("properties")
}

// Many-to-many: a lead may be interested in several properties, a property
// may have several interested leads. Structurally identical to LeadTag.
model LeadProperty {
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([leadId, propertyId])
  @@map("lead_properties")
}

// One active preference set per contact (not per lead) - buyer intent
// persists across the relationship, not just one deal.
model BuyerPreference {
  id                  String             @id @default(uuid())
  organizationId      String
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId           String
  contact             Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  transactionType     TransactionType    @default(SALE)
  minPriceCents       BigInt?
  maxPriceCents       BigInt?
  currency            String             @default("USD")
  minAreaSqm          Float?
  bedrooms            Int?
  country             String?
  city                String?
  districts           String[]           @default([])
  propertyType        PropertyType?
  // RENT-only qualification
  furnished           Boolean?
  moveInDate          DateTime?
  leaseDurationMonths Int?
  hasPets             Boolean?
  occupantCount       Int?
  // SALE-only qualification
  financingType       FinancingType?
  purchaseTimeframe   PurchaseTimeframe?
  notes               String?            @db.Text
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([contactId, transactionType])
  @@map("buyer_preferences")
}

enum ViewingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// Deliberately does not write an Activity row on status change - ActivityType
// is a Core enum and a vertical-specific value there would blur the line this
// refactor exists to draw. Revisit if/when Activity itself grows a vertical
// extension point.
model Viewing {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  scheduledFor   DateTime
  status         ViewingStatus @default(SCHEDULED)
  assignedUserId String?
  assignedUser   User?         @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, scheduledFor])
  @@index([leadId])
  @@map("viewings")
}

// ---------------------------------------------------------------------------
// Instagram/TikTok existing-inventory import. Deliberately NOT modeled on
// ContentItem - that model is shaped for YoYo-authored outbound publishing
// (approval workflow, publish-attempt tracking) and would conflate concerns
// for content that already existed on the platform before YoYo ever saw it.
// Reuses ConnectedAccount as the account model - no separate SocialAccount.
// ---------------------------------------------------------------------------

enum SocialMediaType {
  IMAGE
  VIDEO
  REEL
  CAROUSEL
}

enum SocialMediaAnalysisStatus {
  PENDING
  ANALYZING
  ANALYZED
  FAILED
  SKIPPED
}

// Lifecycle of one discovered post, independent of analysisStatus - a post
// can be ANALYZED but never grouped if it wasn't property-related.
enum SocialMediaImportStatus {
  DISCOVERED
  ANALYZED
  CANDIDATE
  LINKED
  IGNORED
}

model SocialMediaItem {
  id                 String                    @id @default(uuid())
  organizationId     String
  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedAccountId String
  connectedAccount   ConnectedAccount          @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  provider           Provider
  providerMediaId    String
  mediaType          SocialMediaType
  caption            String?                   @db.Text
  permalink          String?
  postedAt           DateTime?
  thumbnailUrl       String?
  primaryMediaUrl    String?
  providerMetadata   Json                      @default("{}")
  analysisStatus     SocialMediaAnalysisStatus @default(PENDING)
  analysisResult     Json?
  isPropertyRelated  Boolean?
  analysisConfidence Float?
  candidateId        String?
  candidate          PropertyImportCandidate?  @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  // Denormalized: set once a candidate containing this item is imported/
  // linked, so "show this property's social sources" never needs to join
  // through PropertyImportCandidate.
  propertyId         String?
  property           Property?                 @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  importStatus       SocialMediaImportStatus   @default(DISCOVERED)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  lastSyncedAt       DateTime                  @default(now())

  assets       SocialMediaAsset[]
  sourcedMedia PropertyMedia[]

  // Account-scoped, not global - mirrors ConnectedAccount's own tenant
  // boundary rather than assuming provider media ids are globally unique.
  @@unique([connectedAccountId, providerMediaId])
  @@index([organizationId, importStatus])
  @@index([candidateId])
  @@map("social_media_items")
}

// Carousel children. Reuses MediaAssetKind (IMAGE/VIDEO) from the
// ContentMediaAsset model above rather than a duplicate enum.
model SocialMediaAsset {
  id                String          @id @default(uuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  socialMediaItemId String
  socialMediaItem   SocialMediaItem @relation(fields: [socialMediaItemId], references: [id], onDelete: Cascade)
  position          Int
  kind              MediaAssetKind
  mediaUrl          String
  thumbnailUrl      String?
  providerChildId   String?
  createdAt         DateTime        @default(now())

  @@unique([socialMediaItemId, position])
  @@map("social_media_assets")
}

enum PropertyImportCandidateStatus {
  PENDING_REVIEW
  IMPORTED
  LINKED_EXISTING
  IGNORED
}

// One review/grouping unit - many SocialMediaItem rows may point at one
// candidate (e.g. 3 posts for the same listing). reviewedByUserId is a bare
// column (no relation) to avoid widening the User model for this feature.
model PropertyImportCandidate {
  id                         String                        @id @default(uuid())
  organizationId             String
  organization               Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedAccountId         String
  status                     PropertyImportCandidateStatus @default(PENDING_REVIEW)
  confidence                 Float
  transactionType            TransactionType
  propertyType               PropertyType
  title                      String
  description                String?                       @db.Text
  priceCents                 BigInt?
  currency                   String                        @default("USD")
  country                    String?
  city                       String?
  district                   String?
  address                    String?
  bedrooms                   Int?
  bathrooms                  Int?
  areaSqm                    Float?
  availabilityHint           String?
  possibleExistingPropertyId String?
  possibleExistingProperty   Property?                     @relation("PossibleExistingProperty", fields: [possibleExistingPropertyId], references: [id], onDelete: SetNull)
  importedPropertyId         String?
  importedProperty           Property?                     @relation("ImportedProperty", fields: [importedPropertyId], references: [id], onDelete: SetNull)
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt
  reviewedAt                 DateTime?
  reviewedByUserId           String?

  items SocialMediaItem[]

  @@index([organizationId, status])
  @@map("property_import_candidates")
}

enum PropertyMediaKind {
  IMAGE
  VIDEO
  FLOORPLAN
  OTHER
}

enum PropertyMediaSource {
  MANUAL
  INSTAGRAM
  TIKTOK
}

model PropertyMedia {
  id                      String              @id @default(uuid())
  organizationId          String
  organization            Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId              String
  property                Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  kind                    PropertyMediaKind
  // Exactly one of these is expected to be set. storageKey is null for MVP
  // social imports (provider-hosted URLs used directly - they can expire; a
  // later job copying media into packages/storage is a pure addition, not a
  // migration).
  storageKey              String?
  externalUrl             String?
  source                  PropertyMediaSource @default(MANUAL)
  sourceSocialMediaItemId String?
  sourceSocialMediaItem   SocialMediaItem?    @relation(fields: [sourceSocialMediaItemId], references: [id], onDelete: SetNull)
  position                Int                 @default(0)
  isCover                 Boolean             @default(false)
  createdAt               DateTime            @default(now())

  @@index([organizationId, propertyId])
  @@map("property_media")
}

enum SocialSyncType {
  INITIAL
  INCREMENTAL
}

enum SocialSyncStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}

// Durable, queryable job state - the frontend polls this, not BullMQ job
// state directly (BullMQ's job store isn't a product-facing progress/history
// source).
model SocialSync {
  id                   String           @id @default(uuid())
  organizationId       String
  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedAccountId   String
  connectedAccount     ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  type                 SocialSyncType   @default(INITIAL)
  status               SocialSyncStatus @default(QUEUED)
  totalItems           Int              @default(0)
  processedItems       Int              @default(0)
  propertyRelatedItems Int              @default(0)
  candidateCount       Int              @default(0)
  errorCount           Int              @default(0)
  startedAt            DateTime?
  completedAt          DateTime?
  lastError            String?          @db.Text
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([organizationId, connectedAccountId, createdAt])
  @@map("social_syncs")
}
