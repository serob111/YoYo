{
  "name": "@yoyo/database",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force --skip-seed",
    "db:seed:load-test": "node dist/seed-load-test.js"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@yoyo/crypto": "workspace:*",
    "argon2": "^0.41.1",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@yoyo/typescript-config": "workspace:*",
    "prisma": "^5.20.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
