# Copy to .env.staging ON THE VPS ONLY and fill in real values.
# Never commit a real .env.staging file - it holds live secrets.
# Used by: docker-compose.staging.yml (both the infra services below and,
# via `env_file:`, every app container) and Caddyfile (WEB_HOST/API_HOST/STORAGE_HOST).

NODE_ENV=production

# --- Caddy / hostnames ---
# sslip.io gives free real hostnames that resolve straight to your VPS IP, so
# Caddy can issue real Let's Encrypt certs with no domain purchase and no DNS
# setup. Replace 203-0-113-10 with your VPS's actual IP, dashes instead of
# dots. Swapping in a real domain later is just changing these three lines.
WEB_HOST=web.203-0-113-10.sslip.io
API_HOST=api.203-0-113-10.sslip.io
STORAGE_HOST=storage.203-0-113-10.sslip.io

# --- API ---
PORT=4000
API_PUBLIC_URL=https://api.203-0-113-10.sslip.io
WEB_APP_URL=https://web.203-0-113-10.sslip.io

# --- Postgres (container hostname "postgres" - see docker-compose.staging.yml) ---
POSTGRES_USER=yoyo
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=yoyo
DATABASE_URL=postgresql://yoyo:replace-with-a-long-random-password@postgres:5432/yoyo

# --- Redis (container hostname "redis") ---
REDIS_URL=redis://redis:6379

SESSION_COOKIE_NAME=yoyo_session
# Generate with: openssl rand -hex 32
SESSION_COOKIE_SECRET=replace-with-a-random-64-char-hex-string
SESSION_TTL_HOURS=720

CSRF_COOKIE_NAME=yoyo_csrf

MAGIC_LINK_TTL_MINUTES=30

# --- Object storage (self-hosted MinIO) ---
# Must be the PUBLIC HTTPS host (via Caddy -> minio:9000), not the internal
# "http://minio:9000" - apps/api/src/media only ever hands out presigned
# URLs, and this value is embedded directly into them, so it has to be
# reachable by whatever holds the URL (a browser, this staging's k6 harness),
# not just by other containers.
S3_ENDPOINT=https://storage.203-0-113-10.sslip.io
S3_REGION=us-east-1
S3_BUCKET=yoyo-staging
S3_ACCESS_KEY_ID=yoyo
S3_SECRET_ACCESS_KEY=replace-with-a-long-random-password
S3_FORCE_PATH_STYLE=true

# --- Email (console provider - staging emails only show up in worker-email's
# logs, nothing is actually sent; fine unless you specifically need to test
# magic-link/invite delivery this pass) ---
EMAIL_FROM_ADDRESS=no-reply@example.com

# --- Rate limiting (defaults are fine for staging) ---
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX_ATTEMPTS=10

PRISMA_LOG_QUERIES=false

# --- Web ---
NEXT_PUBLIC_API_URL=https://api.203-0-113-10.sslip.io
# Gates the entire dashboard behind HTTP Basic Auth (apps/web/src/middleware.ts) -
# required so the login page itself isn't publicly reachable. Leave both
# blank only if you intentionally want the dashboard fully public.
STAGING_BASIC_AUTH_USER=replace-with-a-username
STAGING_BASIC_AUTH_PASSWORD=replace-with-a-long-random-password

# --- Instagram ---
# Use a NEW Meta App dedicated to staging, kept in Development Mode, with
# only your test Instagram account added as a Tester - see the plan's
# integration setup steps for exact dashboard clicks.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=replace-with-any-string-you-choose
META_GRAPH_API_VERSION=v23.0
META_OAUTH_REDIRECT_URI=https://api.203-0-113-10.sslip.io/integrations/instagram/callback
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-a-random-64-char-hex-string

# --- AI (only apps/worker-ai reads these) ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
AI_DEFAULT_MODEL=claude-sonnet-5
AI_EMBEDDING_MODEL=voyage-4

# --- TikTok (only if TikTok is in scope for this staging pass) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_OAUTH_REDIRECT_URI=https://api.203-0-113-10.sslip.io/integrations/tiktok/callback

# --- Content generation (not part of the requested scenario - leave blank
# unless you also deploy worker-content) ---
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image

# --- Billing (Phase G, still paused - leave blank) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_SOLO=
STRIPE_PRICE_ID_TEAM=
STRIPE_PRICE_ID_AGENCY=
