# Copy to .env and fill in real values for local development.
# Never commit a real .env file.

NODE_ENV=development

# --- API ---
PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_APP_URL=http://localhost:3000

DATABASE_URL=postgresql://yoyo:yoyo@localhost:5434/yoyo

REDIS_URL=redis://localhost:6379

SESSION_COOKIE_NAME=yoyo_session
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_COOKIE_SECRET=replace-with-a-random-64-char-hex-string-before-running-anything
SESSION_TTL_HOURS=720

CSRF_COOKIE_NAME=yoyo_csrf

MAGIC_LINK_TTL_MINUTES=30

# --- Object storage (MinIO locally) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=yoyo-local
S3_ACCESS_KEY_ID=yoyo
S3_SECRET_ACCESS_KEY=yoyo12345
S3_FORCE_PATH_STYLE=true

# --- Email (console provider logs instead of sending in local/dev) ---
EMAIL_FROM_ADDRESS=no-reply@example.com

# --- Rate limiting ---
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX_ATTEMPTS=10

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Instagram (Phase 2) ---
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v23.0
META_OAUTH_REDIRECT_URI=http://localhost:4000/integrations/instagram/callback
ENCRYPTION_KEY=replace-with-a-random-32-byte-value-base64-or-hex

# Optional: only for a manual smoke test against one real connected test account.
# Leave blank otherwise - the automated test suite mocks the HTTP boundary.
INSTAGRAM_TEST_ACCESS_TOKEN=
INSTAGRAM_TEST_ACCOUNT_ID=
